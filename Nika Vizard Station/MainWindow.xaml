                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </TabItem>
                        </TabControl>

                    </customGrid:CustomGrid>


                </customGrid:CustomGrid>
                <Canvas
                    x:Name="LoadCanvas"
                    Background="#338E8E8E"
                    Visibility="Collapsed">
                    <Grid Width="{Binding ElementName=LoadCanvas, Path=ActualWidth}" Height="{Binding ElementName=LoadCanvas, Path=ActualHeight}">
                        <Rectangle
                            Grid.Column="1"
                            Width="300"
                            Height="100"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Fill="#FF354660"
                            RadiusX="20"
                            RadiusY="20"
                            Stroke="#FF13243C"
                            StrokeThickness="3" />
                        <Rectangle
                            Width="270"
                            Height="30"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            RadiusX="10"
                            RadiusY="10"
                            Stroke="#FF13243C"
                            StrokeThickness="3">
                            <Rectangle.Clip>
                                <RectangleGeometry
                                    RadiusX="10"
                                    RadiusY="10"
                                    Rect="0,0,270,30" />
                            </Rectangle.Clip>
                            <Rectangle.Fill>
                                <VisualBrush>
                                    <VisualBrush.Visual>
                                        <ProgressBar
                                            x:Name="loadBar"
                                            Width="270"
                                            Height="20"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Foreground="#FF8BCA74"
                                            Maximum="100"
                                            Value="0" />
                                    </VisualBrush.Visual>
                                </VisualBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                    </Grid>
                </Canvas>
            </Grid>
        </customGrid:CustomGrid>


    </Border>
</Window>

