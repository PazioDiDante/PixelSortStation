<Window
    x:Class="Nika_Vizard_Station.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:customGrid="clr-namespace:Nika_Vizard_Station.Styles"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Nika_Vizard_Station.Converters"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    Title="[PixelSortStation]"
    Width="1150"
    Height="550"
    MinWidth="1150"
    MinHeight="550"
    AllowsTransparency="True"
    Background="#FF354660"
    FontFamily="{StaticResource Forza}"
    FontWeight="Normal"
    Icon="/assets/NikaVizardIcon.ico"
    ResizeMode="CanResize"
    SizeChanged="Window_SizeChanged"
    WindowStyle="None"
    mc:Ignorable="d">
    <Window.Resources>
        <local:CurveValueConverter x:Key="CurveValueConverter" />
        <local:TimeLineConverter x:Key="TimeLineConverter" />
        <local:SliderValueToColorConverter x:Key="SliderValueToColorConverter" />
        <local:SaturationValueToColorConverter x:Key="SaturationValueToColorConverter" />
        <local:HueValueToColorConverter x:Key="HueValueToColorConverter" />
        <local:FadeValueToColorConverter x:Key="FadeValueToColorConverter" />
        <local:InvertValueToColorConverter x:Key="InvertValueToColorConverter" />
        <local:TemperatureValueToColorConverter x:Key="TemperatureValueToColorConverter" />
        <local:IntToGradientBrushConverter x:Key="IntToGradientBrushConverter" />
        <local:WidthToCachSegmentConverter x:Key="WidthToCachSegmentConverter" />

    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight=" 1"
            CornerRadius="20"
            GlassFrameThickness=" 0"
            ResizeBorderThickness=" 8" />
    </WindowChrome.WindowChrome>
    <Window.Clip>
        <RectangleGeometry
            x:Name="RoundBorder"
            RadiusX="22"
            RadiusY="22"
            Rect="0,0,1300,700" />
    </Window.Clip>
    <Border
        BorderBrush="#FF13243C"
        BorderThickness="4"
        CornerRadius="20">


        <customGrid:CustomGrid
            x:Name="MainGrid"
            GridLineBrush="#FF13243C"
            GridLineThickness="3"
            ShowCustomGridLines="True">
            <customGrid:CustomGrid.RowDefinitions>
                <RowDefinition Height="35" />
                <RowDefinition Height="*" />
            </customGrid:CustomGrid.RowDefinitions>

            <Border
                BorderBrush="#FF13243C"
                BorderThickness="1"
                CornerRadius="15,15,0,0"
                MouseLeftButtonDown="DragWindow">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#FF627698" />
                        <GradientStop Offset="1" Color="#FF485B77" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <Image
                            Width="25 "
                            Height="25"
                            Margin="10,0,0,0"
                            Source="/assets/NikaVizardIcon.ico"
                            Stretch="Uniform">
                            <Image.Effect>
                                <DropShadowEffect
                                    BlurRadius="20"
                                    Opacity="0.5"
                                    ShadowDepth="0"
                                    Color="#FFF9F9FF" />
                            </Image.Effect>
                        </Image>
                        <TextBlock
                            Grid.Row="0"
                            Margin="10,0,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource Arsenal}"
                            FontSize="20">
                            [PixelSortStation]
                        </TextBlock>
                    </StackPanel>
                    <StackPanel
                        Margin="0,0,3,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                        <Button
                            x:Name="Hide"
                            Width="30"
                            Height="30"
                            Background="{x:Null}"
                            BorderBrush="{x:Null}"
                            Click="Hide_Click"
                            Foreground="{x:Null}"
                            Style="{StaticResource ThreeButtons}">
                            <Path
                                Margin="7,14,7,0"
                                Fill="#FF475E7F"
                                Stretch="Uniform"
                                Stroke="#FFF9F9FF"
                                StrokeLineJoin="Round"
                                StrokeThickness="2">
                                <Path.Data>
                                    <PathGeometry>
                                        <PathGeometry.Figures>
                                            <PathFigure
                                                IsClosed="True"
                                                IsFilled="True"
                                                StartPoint="0,30">
                                                <LineSegment Point=" 30,30" />
                                            </PathFigure>


                                        </PathGeometry.Figures>
                                    </PathGeometry>
                                </Path.Data>

                            </Path>
                        </Button>
                        <Button
                            x:Name="Expand"
                            Width="30"
                            Height="30"
                            Background="{x:Null}"
                            BorderBrush="{x:Null}"
                            Click="Expand_Click"
                            Foreground="{x:Null}"
                            Style="{StaticResource ThreeButtons}">
                            <Path
                                Margin="7"
                                Fill="#FF475E7F"
                                Stretch="Uniform"
                                Stroke="#FFF9F9FF"
                                StrokeLineJoin="Round"
                                StrokeThickness="2">
                                <Path.Data>
                                    <PathGeometry>
                                        <PathGeometry.Figures>
                                            <PathFigure
                                                IsClosed="True"
                                                IsFilled="True"
                                                StartPoint="0,30">
                                                <LineSegment Point=" 0,10" />
                                                <LineSegment Point=" 20,10" />
                                                <LineSegment Point="20,30" />
                                            </PathFigure>
                                            <PathFigure IsFilled="True" StartPoint="10,10">
                                                <LineSegment Point=" 10,0" />
                                                <LineSegment Point=" 30,0" />
                                                <LineSegment Point=" 30,20" />
                                                <LineSegment Point=" 20,20" />
                                            </PathFigure>
                                        </PathGeometry.Figures>
                                    </PathGeometry>
                                </Path.Data>

                            </Path>
                        </Button>
                        <Button
                            x:Name="Close"
                            Width="30"
                            Height="30"
                            Background="{x:Null}"
                            BorderBrush="{x:Null}"
                            Click="Close_Click"
                            Foreground="{x:Null}"
                            Style="{StaticResource ThreeButtons}">
                            <Path
                                Margin="7"
                                Fill="#FF475E7F"
                                Stretch="Uniform"
                                Stroke="#FFF9F9FF"
                                StrokeLineJoin="Round"
                                StrokeThickness="2">
                                <Path.Data>
                                    <PathGeometry>
                                        <PathGeometry.Figures>
                                            <PathFigure
                                                IsClosed="True"
                                                IsFilled="True"
                                                StartPoint="0,0">
                                                <LineSegment Point=" 30,30" />
                                            </PathFigure>
                                            <PathFigure
                                                IsClosed="True"
                                                IsFilled="True"
                                                StartPoint="30,0">
                                                <LineSegment Point=" 0,30" />
                                            </PathFigure>
                                        </PathGeometry.Figures>
                                    </PathGeometry>
                                </Path.Data>
                            </Path>
                        </Button>

                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Row="1">

                <customGrid:CustomGrid
                    Grid.Row="1"
                    GridLineBrush="#FF13243C"
                    GridLineThickness="3"
                    ShowCustomGridLines="True">

                    <customGrid:CustomGrid
                        GridLineBrush="#FF13243C"
                        GridLineThickness="3"
                        ShowCustomGridLines="True">
                        <customGrid:CustomGrid.ColumnDefinitions>
                            <ColumnDefinition Width="300" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="350" />
                        </customGrid:CustomGrid.ColumnDefinitions>
                        <customGrid:CustomGrid
                            GridLineBrush="#FF13243C"
                            GridLineThickness="3"
                            ShowCustomGridLines="True">
                            <customGrid:CustomGrid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </customGrid:CustomGrid.RowDefinitions>
                            <StackPanel Grid.Row="0">


                                <Button
                                    x:Name="CEbutton"
                                    Height="35"
                                    Margin="5"
                                    VerticalAlignment="Top"
                                    Click="Curve_Click"
                                    Content="Color Editing"
                                    IsEnabled="False"
                                    Style="{StaticResource RoundedGradientButton}" />

                                <Button
                                    x:Name="PSbutton"
                                    Height="35"
                                    Margin="5"
                                    VerticalAlignment="Top"
                                    Click="Sorting_Click"
                                    Content="Pixel Sorting"
                                    IsEnabled="False"
                                    Style="{StaticResource RoundedGradientButton}" />
                                <Button
                                    x:Name="MakeBeauty"
                                    Height="35"
                                    Margin="5"
                                    VerticalAlignment="Top"
                                    Click="MakeBeauty_Click"
                                    Content="Make Beauty"
                                    IsEnabled="False"
                                    Style="{StaticResource RoundedGradientButton}" />
                            </StackPanel>
                            <StackPanel Grid.Row="2">
                                <Button
                                    x:Name="LoadPicture"
                                    Height="35"
                                    Margin="5"
                                    VerticalAlignment="Top"
                                    Click="LoadPicture_Click"
                                    Content="Load Picture"
                                    Style="{StaticResource RoundedGradientButton}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button
                                        x:Name="SaveImage"
                                        Grid.Column="0"
                                        Height="35"
                                        Margin="5"
                                        VerticalAlignment="Top"
                                        Click="SaveImage_Click"
                                        Content="Save Image"
                                        IsEnabled="false"
                                        Style="{StaticResource RoundedGradientButton}" />
                                    <Button
                                        x:Name="SaveGif"
                                        Grid.Column="1"
                                        Height="35"
                                        Margin="5"
                                        VerticalAlignment="Top"
                                        Click="SaveGif_Click"
                                        Content="Save GIF"
                                        IsEnabled="false"
                                        Style="{StaticResource RoundedGradientButton}" />
                                </Grid>
                            </StackPanel>
                        </customGrid:CustomGrid>


                        <customGrid:CustomGrid
                            Grid.Column="1"
                            GridLineBrush="#FF13243C"
                            GridLineThickness="3"
                            ShowCustomGridLines="True">
                            <customGrid:CustomGrid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </customGrid:CustomGrid.RowDefinitions>

                            <Border
                                Margin="10"
                                Padding="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                BorderBrush="#FF13243C"
                                BorderThickness="3"
                                CornerRadius="5">
                                <Grid>
                                    <StackPanel Name="ImageBack">
                                        <TextBlock
                                            Grid.Row="0"
                                            Margin="0,30,0,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Top"
                                            FontFamily="{StaticResource Arsenal}"
                                            FontSize="55"
                                            Foreground="#FF13243C">
                                            [PixelSortStation]
                                        </TextBlock>
                                        <Image
                                            Width="200 "
                                            Height="200"
                                            Margin="0,0,0,0"
                                            VerticalAlignment="Bottom"
                                            Source="/assets/NikaVizardLogoBig.png"
                                            Stretch="Uniform">
                                            <Image.Effect>
                                                <DropShadowEffect
                                                    BlurRadius="3"
                                                    Opacity="0.8"
                                                    ShadowDepth="0"
                                                    Color="#FF13243C" />
                                            </Image.Effect>
                                        </Image>
                                    </StackPanel>
                                    <Image
                                        x:Name="MainImage"
                                        Grid.Column="2"
                                        Loaded="Image_OnLoaded"
                                        SizeChanged="MainImage_SizeChanged" />

                                </Grid>
                            </Border>
                            <Grid Grid.Row="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Name="TimeLineText"
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Padding="5"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="20"
                                        Text="{Binding ElementName=Timeline, Path=Value, Converter={StaticResource TimeLineConverter}}" />
                                    <StackPanel
                                        Grid.Column="1"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                        <!--  At the begining  -->
                                        <Button
                                            x:Name="Begining"
                                            Width="25"
                                            Height="25"
                                            Margin="5"
                                            Background="{x:Null}"
                                            BorderBrush="{x:Null}"
                                            Click="Begining_Click"
                                            Foreground="{x:Null}"
                                            Style="{StaticResource ButtonPressStyle}">
                                            <Path
                                                Fill="#FF475E7F"
                                                Stretch="Uniform"
                                                Stroke="#FF475E7F"
                                                StrokeLineJoin="Round"
                                                StrokeThickness="4">
                                                <Path.Data>
                                                    <PathGeometry>
                                                        <PathGeometry.Figures>
                                                            <PathFigure
                                                                IsClosed="True"
                                                                IsFilled="True"
                                                                StartPoint="25,0">
                                                                <LineSegment Point=" 0,15" />
                                                                <LineSegment Point=" 25,30" />
                                                            </PathFigure>
                                                            <PathFigure
                                                                IsClosed="True"
                                                                IsFilled="True"
                                                                StartPoint="0,0">
                                                                <LineSegment Point=" 0,30" />
                                                            </PathFigure>
                                                        </PathGeometry.Figures>
                                                    </PathGeometry>
                                                </Path.Data>
                                                <Path.Effect>
                                                    <DropShadowEffect
                                                        BlurRadius="6"
                                                        Direction="270"
                                                        Opacity="0.5"
                                                        ShadowDepth="4"
                                                        Color="#FF1C1C23" />
                                                </Path.Effect>
                                            </Path>
                                        </Button>
                                        <!--  Frame Back  -->
                                        <Button
                                            Name="PreviousFrame"
                                            Width="25"
                                            Height="25"
                                            Margin="5"
                                            Background="{x:Null}"
                                            BorderBrush="{x:Null}"
                                            Click="Begining_Click"
                                            Foreground="{x:Null}"
                                            Style="{StaticResource ButtonPressStyle}">
                                            <Path
                                                Fill="#FF475E7F"
                                                Stretch="Uniform"
                                                Stroke="#FF475E7F"
                                                StrokeLineJoin="Round"
                                                StrokeThickness="4">
                                                <Path.Data>
                                                    <PathGeometry>
                                                        <PathGeometry.Figures>
                                                            <PathFigure
                                                                IsClosed="True"
                                                                IsFilled="True"
                                                                StartPoint="25,0">
                                                                <LineSegment Point=" 0,15" />
                                                                <LineSegment Point=" 25,30" />
                                                            </PathFigure>
                                                            <PathFigure
                                                                IsClosed="True"
                                                                IsFilled="True"
                                                                StartPoint="32,0">
                                                                <LineSegment Point=" 32,30" />
                                                            </PathFigure>
                                                        </PathGeometry.Figures>
                                                    </PathGeometry>
                                                </Path.Data>
                                                <Path.Effect>
                                                    <DropShadowEffect
                                                        BlurRadius="6"
                                                        Direction="270"
                                                        Opacity="0.5"
                                                        ShadowDepth="4"
                                                        Color="#FF1C1C23" />
                                                </Path.Effect>
                                            </Path>
                                        </Button>
                                        <Grid>

                                            <!--  Pause  -->
                                            <Button
                                                Name="Pause"
                                                Width="25"
                                                Height="25"
                                                Margin="5"
                                                Background="{x:Null}"
                                                BorderBrush="{x:Null}"
                                                Click="PauseButton"
                                                Foreground="{x:Null}"
                                                Style="{StaticResource ButtonPressStyle}"
                                                Visibility="Hidden">
                                                <Path
                                                    Fill="#FF475E7F"
                                                    Stretch="Uniform"
                                                    Stroke="#FF475E7F"
                                                    StrokeLineJoin="Round"
                                                    StrokeThickness="4">
                                                    <Path.Data>
                                                        <PathGeometry>
                                                            <PathGeometry.Figures>
                                                                <PathFigure
                                                                    IsClosed="True"
                                                                    IsFilled="True"
                                                                    StartPoint="20,0">
                                                                    <LineSegment Point=" 20,25" />
                                                                </PathFigure>
                                                                <PathFigure
                                                                    IsClosed="True"
                                                                    IsFilled="True"
                                                                    StartPoint="30,0">
                                                                    <LineSegment Point=" 30,25" />
                                                                </PathFigure>
                                                            </PathGeometry.Figures>
                                                        </PathGeometry>
                                                    </Path.Data>
                                                    <Path.Effect>
                                                        <DropShadowEffect
                                                            BlurRadius="6"
                                                            Direction="270"
                                                            Opacity="0.5"
                                                            ShadowDepth="4"
                                                            Color="#FF1C1C23" />
                                                    </Path.Effect>
                                                </Path>
                                            </Button>
                                            <!--  Пуск  -->
                                            <Button
                                                Name="Play"
                                                Width="25"
                                                Height="25"
                                                Margin="5"
                                                Background="{x:Null}"
                                                BorderBrush="{x:Null}"
                                                Click="PlayButton"
                                                Foreground="{x:Null}"
                                                Style="{StaticResource ButtonPressStyle}">
                                                <Path
                                                    Fill="#FF475E7F"
                                                    Stretch="Uniform"
                                                    Stroke="#FF475E7F"
                                                    StrokeLineJoin="Round"
                                                    StrokeThickness="4">
                                                    <Path.Data>
                                                        <PathGeometry>
                                                            <PathGeometry.Figures>
                                                                <PathFigure
                                                                    IsClosed="True"
                                                                    IsFilled="True"
                                                                    StartPoint="0,0">
                                                                    <LineSegment Point=" 25,15" />
                                                                    <LineSegment Point=" 0,30" />
                                                                </PathFigure>

                                                            </PathGeometry.Figures>
                                                        </PathGeometry>
                                                    </Path.Data>
                                                    <Path.Effect>
                                                        <DropShadowEffect
                                                            BlurRadius="6"
                                                            Direction="270"
                                                            Opacity="0.5"
                                                            ShadowDepth="4"
                                                            Color="#FF1C1C23" />
                                                    </Path.Effect>
                                                </Path>
                                            </Button>
                                        </Grid>

                                        <!--  Frame Forward  -->
                                        <Button
                                            Name="NextFrame"
                                            Width="25"
                                            Height="25"
                                            Margin="5"
                                            Background="{x:Null}"
                                            BorderBrush="{x:Null}"
                                            Click="Begining_Click"
                                            Foreground="{x:Null}"
                                            Style="{StaticResource ButtonPressStyle}">
                                            <Path
                                                Fill="#FF475E7F"
                                                Stretch="Uniform"
                                                Stroke="#FF475E7F"
                                                StrokeLineJoin="Round"
                                                StrokeThickness="4">
                                                <Path.Data>
                                                    <PathGeometry>
                                                        <PathGeometry.Figures>
                                                            <PathFigure
                                                                IsClosed="True"
                                                                IsFilled="True"
                                                                StartPoint="0,0">
                                                                <LineSegment Point=" 25,15" />
                                                                <LineSegment Point=" 0,30" />
                                                            </PathFigure>
                                                            <PathFigure
                                                                IsClosed="True"
                                                                IsFilled="True"
                                                                StartPoint="-7,0">
                                                                <LineSegment Point=" -7,30" />
                                                            </PathFigure>
                                                        </PathGeometry.Figures>
                                                    </PathGeometry>
                                                </Path.Data>
                                                <Path.Effect>
                                                    <DropShadowEffect
                                                        BlurRadius="6"
                                                        Direction="270"
                                                        Opacity="0.5"
                                                        ShadowDepth="4"
                                                        Color="#FF1C1C23" />
                                                </Path.Effect>
                                            </Path>
                                        </Button>

                                        <!--  At the end  -->
                                        <Button
                                            Name="End"
                                            Width="25"
                                            Height="25"
                                            Margin="5"
                                            Background="{x:Null}"
                                            BorderBrush="{x:Null}"
                                            Click="Begining_Click"
                                            Foreground="{x:Null}"
                                            Style="{StaticResource ButtonPressStyle}">
                                            <Path
                                                Fill="#FF475E7F"
                                                Stretch="Uniform"
                                                Stroke="#FF475E7F"
                                                StrokeLineJoin="Round"
                                                StrokeThickness="4">
                                                <Path.Data>
                                                    <PathGeometry>
                                                        <PathGeometry.Figures>
                                                            <PathFigure
                                                                IsClosed="True"
                                                                IsFilled="True"
                                                                StartPoint="0,0">
                                                                <LineSegment Point=" 25,15" />
                                                                <LineSegment Point=" 0,30" />
                                                            </PathFigure>
                                                            <PathFigure
                                                                IsClosed="True"
                                                                IsFilled="True"
                                                                StartPoint="25,0">
                                                                <LineSegment Point=" 25,30" />
                                                            </PathFigure>
                                                        </PathGeometry.Figures>
                                                    </PathGeometry>
                                                </Path.Data>
                                                <Path.Effect>
                                                    <DropShadowEffect
                                                        BlurRadius="6"
                                                        Direction="270"
                                                        Opacity="0.5"
                                                        ShadowDepth="4"
                                                        Color="#FF1C1C23" />
                                                </Path.Effect>
                                            </Path>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <Grid Grid.Row="1" Margin="0,5,0,0">
                                    <Slider
                                        Name="Timeline"
                                        Grid.Row="1"
                                        Margin="20,0,20,0"
                                        VerticalAlignment="Top"
                                        IsMoveToPointEnabled="True"
                                        Maximum="10"
                                        Minimum="0"
                                        Style="{StaticResource TimelineStyle}"
                                        ValueChanged="Timeline_ValueChanged_1"
                                        Value="0" />
                                    <Slider
                                        Name="TimelineStart"
                                        Grid.Row="1"
                                        Margin="20,0,20,0"
                                        VerticalAlignment="Top"
                                        Maximum="10"
                                        Minimum="0"
                                        Style="{StaticResource TimelineStartStyle}"
                                        Value="0" />
                                    <Slider
                                        Name="TimelineEnd"
                                        Grid.Row="1"
                                        Margin="20,0,20,0"
                                        VerticalAlignment="Top"
                                        Maximum="10"
                                        Minimum="0"
                                        Style="{StaticResource TimelineEndStyle}"
                                        Value="10" />
                                </Grid>
                                <Grid Grid.Row="2">
                                    <TextBlock
                                        Name="TimeLineStartText"
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Padding="5"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        FontSize="20"
                                        Text="{Binding ElementName=TimelineStart, Path=Value, Converter={StaticResource TimeLineConverter}}" />
                                    <TextBlock
                                        Name="TimeLineEndText"
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Margin="5,0,5,0"
                                        Padding="5"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        FontSize="20"
                                        Text="{Binding ElementName=TimelineEnd, Path=Value, Converter={StaticResource TimeLineConverter}}" />

                                </Grid>
                            </Grid>
                        </customGrid:CustomGrid>
                        <TabControl
                            x:Name="SettingsTabControl"
                            Grid.Column="2"
                            Background="{x:Null}"
                            BorderThickness="0">
                            <TabControl.Resources>
                                <Style TargetType="TabItem">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </Style>
                            </TabControl.Resources>
                            <TabItem />
                            <TabItem>
                                <Border
                                    Margin="5"
                                    Padding="10"
                                    VerticalAlignment="Top"
                                    BorderBrush="#FF13243C"
                                    BorderThickness="3"
                                    CornerRadius="5">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                            <GradientStop Color="#FF4F688C" />
                                            <GradientStop Offset="1" Color="#FF2C3B52" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock
                                            Grid.Row="0"
                                            Margin="5,5,5,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            FontSize="17">
                                            Random Power
                                        </TextBlock>
                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox
                                                Name="RandomAnimation"
                                                Margin="5,0,0,0"
                                                VerticalAlignment="Center"
                                                Background="{x:Null}">
                                                Animation
                                            </CheckBox>
                                            <Grid Grid.Column="1" Margin="0,0,5,0">
                                                <Border
                                                    Grid.Column="1"
                                                    Height="12"
                                                    VerticalAlignment="Center"
                                                    BorderBrush="#FF13243C"
                                                    BorderThickness="3"
                                                    CornerRadius="5">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="1,1" EndPoint="0,0">
                                                            <GradientStop Offset="0" Color="#FFEA8267" />
                                                            <GradientStop Offset="0.125" Color="#FF8BD376" />
                                                            <GradientStop Offset="0.25" Color="#FF00ADE3" />
                                                            <GradientStop Offset="0.375" Color="#FF8E85E4" />
                                                            <GradientStop Offset="0.5" Color="#FF6D94A0" />
                                                            <GradientStop Offset="1" Color="#FF353535" />
                                                        </LinearGradientBrush>
